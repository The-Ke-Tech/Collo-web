generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id         String   @id @default(uuid())
  name       String?
  email      String   @unique
  password   String?
  profilePic String?
  role       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  orders     Order[]
  cartItems  AddToCart[]
}

model Product {
  id           String   @id @default(uuid())
  productName  String?
  brandName    String?
  category     String?
  productImage String[] @default([])
  description  String?
  price        Float?
  sellingPrice Float?
  stock        Int      @default(0)    // <--- NEW FIELD
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  cartItems    AddToCart[]
  orders       OrderProduct[]
}


enum ShippingStage {
  PENDING        // Order placed but not processed
  PACKING        // Being packed
  SHIPPED        // Shipped out
  IN_TRANSIT     // On the way
  DELIVERED      // Delivered to customer
  CANCELLED      // Cancelled order
}

model Order {
  id                     String         @id @default(uuid())
  userId                 String?
  user                   User?          @relation(fields: [userId], references: [id])
  email                  String?
  productDetails         OrderProduct[]
  paymentMethod          String[]       @default([])
  paymentStatus          PaymentStatus  @default(PENDING)
  shippingStage          ShippingStage  @default(PENDING)  
  totalAmount            Float          @default(0)

  fullName               String?
  phone                  String?
  address                String?
  county                 String?
  city                   String?

  mpesaCheckoutRequestId String?        @unique
  mpesaReceiptNumber     String?
  mpesaPhoneNumber       String?

  createdAt              DateTime       @default(now())
  updatedAt              DateTime       @updatedAt
}


enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
}

model OrderProduct {
  id        String   @id @default(uuid())
  order     Order    @relation(fields: [orderId], references: [id])
  orderId   String
  product   Product  @relation(fields: [productId], references: [id])
  productId String
  quantity  Int
}

model AddToCart {
  id        String   @id @default(uuid())
  product   Product  @relation(fields: [productId], references: [id])
  productId String
  quantity  Int
  user      User     @relation(fields: [userId], references: [id])
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, userId]) // Ensures one cart entry per product per user
}

